        <!-- Security notes -->
        <mxCell id="sec" value="Security Guardrails&#xa;• Honeypot field on all public forms (silent bot rejection)&#xa;• Rate limiting on public endpoints&#xa;• OTP expiry + 60s resend cooldown&#xa;• File validation: photos ≤5MB, CVs ≤10MB (PDF/Word)&#xa;• Soft delete — no hard deletes, email anonymised&#xa;• 1 PassRegistration per user (unique constraint)&#xa;• 1 SpeakerApplication per user&#xa;• 1 VolunteerApplication per user" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;align=left;spacingLeft=10;spacingTop=5;" vertex="1" parent="1">
