# Dockerfile.saani — Windows local dev only (used by docker-compose.saani.yml)
#
# Windows saves shell scripts with CRLF line endings and sometimes a UTF-8 BOM.
# Both break Linux's exec/shebang parsing, causing:
#   exec /app/entrypoint.sh: no such file or directory   (CRLF in shebang)
#   exec /app/entrypoint.sh: exec format error           (UTF-8 BOM)
#
# Strategy: at container startup, write a clean LF-only copy of entrypoint.sh
# to /entrypoint-clean.sh (outside the bind-mount) and exec that instead.
# The bind-mount volume (./backend:/app) overwrites /app at runtime, so any
# fix applied during the build layer to /app/entrypoint.sh is lost — that is
# why we write the clean copy outside /app.
#
# Do NOT use this file in production or share with Linux/macOS colleagues.
# Their Dockerfile is ./backend/Dockerfile.

FROM python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1
ENV PYTHONUNBUFFERED=1

WORKDIR /app

RUN apt-get update \
    && apt-get install -y --no-install-recommends libpq-dev gcc \
    && rm -rf /var/lib/apt/lists/*

COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

COPY . .

# Strip CRLF + BOM and install a clean copy OUTSIDE the bind-mount directory
# so the volume override at runtime cannot clobber it.
RUN sed -i 's/\r$//' /app/entrypoint.sh \
    && sed -i '1s/^\xef\xbb\xbf//' /app/entrypoint.sh \
    && cp /app/entrypoint.sh /entrypoint-clean.sh \
    && chmod +x /entrypoint-clean.sh

EXPOSE 8000

# Use the clean copy that lives outside /app (immune to the volume override)
ENTRYPOINT ["/entrypoint-clean.sh"]
CMD ["gunicorn", "config.wsgi:application", "--bind", "0.0.0.0:8000", "--workers", "2"]
