# Django
# Backend entrypoint runs: migrate + seed (pass types, volunteer roles, CMS) on every container start.
DJANGO_SECRET_KEY=change-me-in-production-min-32-chars
DEBUG=True
APP_NAME=Ummah Tech Fest
APP_ENV=development
ALLOWED_HOSTS=localhost,127.0.0.1,backend
# Include every host port you use for the volunteer UI and nginx gateway
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:8080

# Host PostgreSQL (not in Docker)
DB_HOST=host.docker.internal
DB_PORT=5432
DB_NAME=ummah_tech_fest
DB_USER=ummah_tech_fest
DB_PASSWORD=

REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0
LOG_LEVEL=INFO

# Site & email (OTP signup, notifications via Celery worker)
SITE_NAME=Ummah Tech Fest
SITE_URL=http://localhost:8080
# Public SPA URL for links in emails (password reset, etc.)
FRONTEND_URL=http://localhost:5173
PASSWORD_RESET_EXPIRY_HOURS=1
SUPPORT_EMAIL=hello@ummahtechfest.com
DEFAULT_FROM_EMAIL=UmmahTechFest <noreply@ummahtechfest.com>
# Dev: console backend. Production: django.core.mail.backends.smtp.EmailBackend
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
# cPanel / typical hosting: port 587 + TLS (below) OR port 465 + EMAIL_USE_SSL=True
# EMAIL_HOST=mail.example.com
# EMAIL_PORT=587
# EMAIL_HOST_USER=noreply@example.com
# EMAIL_HOST_PASSWORD=
# EMAIL_USE_TLS=True
# EMAIL_USE_SSL=False
# EMAIL_TIMEOUT=30
EMAIL_OTP_EXPIRY_MINUTES=15
EMAIL_OTP_RESEND_COOLDOWN_SECONDS=60
EMAIL_OTP_MAX_RESENDS=5
EMAIL_OTP_MAX_ATTEMPTS=5

# ---------------------------------------------------------------------------
# Published ports (host machine) — change when running multiple portals locally
# ---------------------------------------------------------------------------
API_PORT=8000
FRONTEND_STATIC_PORT=8081
VOLUNTEER_APP_PORT=5173
VOLUNTEER_APP_CONTAINER_PORT=5173
NGINX_PORT=8080
REDIS_PORT=6380

# ---------------------------------------------------------------------------
# Telegram monitoring (major user events → your Telegram chat)
# Create a bot via @BotFather, add it to a group/channel, get chat id via getUpdates.
# ---------------------------------------------------------------------------
TELEGRAM_MONITOR_ENABLED=False
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=
# TELEGRAM_NOTIFY_LOGIN=False

# Future portals (add a service in docker-compose.yml, then set e.g.):
# REGISTRATION_APP_PORT=5174
# REGISTRATION_APP_CONTAINER_PORT=5173

# ---------------------------------------------------------------------------
# Cloudflare R2 (production media) — leave empty for local filesystem storage
# Create API token with Object Read & Write on the bucket.
# ---------------------------------------------------------------------------
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET_NAME=ummah-tech-fest-media
# R2_ENDPOINT_URL=https://<account_id>.r2.cloudflarestorage.com
# Optional public CDN/custom domain (no trailing slash):
# R2_PUBLIC_URL=https://media.ummahtechfest.com
