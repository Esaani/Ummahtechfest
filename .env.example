# Backend entrypoint runs migrate on every start.
# Dev only: seed on start (SEED_ON_START=true). Production: set SEED_ON_START=false and run `make prod-seed` once.
DJANGO_SECRET_KEY=change-me-in-production-min-32-chars
DEBUG=True
APP_NAME=Ummah Tech Fest
APP_ENV=development
SEED_ON_START=true
RUN_COLLECTSTATIC=false
ALLOWED_HOSTS=localhost,127.0.0.1,backend
# Include every host port you use for the volunteer UI (Vite dev server)
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Host PostgreSQL (not in Docker)
DB_HOST=host.docker.internal
DB_PORT=5432
DB_NAME=ummah_tech_fest
DB_USER=ummah_tech_fest
DB_PASSWORD=

REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0
LOG_LEVEL=INFO

# Site & email (OTP signup, notifications via Celery worker)
# IMPORTANT — on production set SITE_URL and FRONTEND_URL to your public domain
# (e.g. https://ummahtechfest.com) so email links and images resolve correctly.
SITE_NAME=Ummah Tech Fest
SITE_URL=http://localhost:5173
# Public SPA URL for links in emails (password reset, etc.)
FRONTEND_URL=http://localhost:5173
# Logo shown in all outgoing emails. Defaults to the production URL; override if
# your logo lives elsewhere (CDN, custom domain, etc.).
# EMAIL_LOGO_URL=https://ummahtechfest.com/assets/images/Ummah-tech-Fest-logo.png
PASSWORD_RESET_EXPIRY_HOURS=1
SUPPORT_EMAIL=hello@ummahtechfest.com
DEFAULT_FROM_EMAIL=UmmahTechFest <noreply@ummahtechfest.com>
# Dev: console backend. Production: django.core.mail.backends.smtp.EmailBackend
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
# cPanel / typical hosting: port 587 + TLS (below) OR port 465 + EMAIL_USE_SSL=True
# EMAIL_HOST=mail.example.com
# EMAIL_PORT=587
# EMAIL_HOST_USER=noreply@example.com
# EMAIL_HOST_PASSWORD=
# EMAIL_USE_TLS=True
# EMAIL_USE_SSL=False
# EMAIL_TIMEOUT=30
EMAIL_OTP_EXPIRY_MINUTES=15
EMAIL_OTP_RESEND_COOLDOWN_SECONDS=60
EMAIL_OTP_MAX_RESENDS=5
EMAIL_OTP_MAX_ATTEMPTS=5

# ---------------------------------------------------------------------------
# Ports — local development only (docker compose up)
# ---------------------------------------------------------------------------
API_PORT=8000
VOLUNTEER_APP_PORT=5173
VOLUNTEER_APP_CONTAINER_PORT=5173
NGINX_PORT=80
REDIS_PORT=6380

# ---------------------------------------------------------------------------
# Telegram monitoring (major user events → your Telegram chat)
# Create a bot via @BotFather, add it to a group/channel, get chat id via getUpdates.
# ---------------------------------------------------------------------------
TELEGRAM_MONITOR_ENABLED=False
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=
# TELEGRAM_NOTIFY_LOGIN=False

# Future portals (add a service in docker-compose.yml, then set e.g.):
# REGISTRATION_APP_PORT=5174
# REGISTRATION_APP_CONTAINER_PORT=5173

# ENABLE_DJANGO_ADMIN=false
# DJANGO_ADMIN_URL_PATH=internal-django-admin

# ---------------------------------------------------------------------------
# Payments (Paystack — https://paystack.com/docs/api/)
# Set in this root .env file (backend reads /app/.env in Docker). After changes:
#   docker compose restart backend
# ---------------------------------------------------------------------------
DEFAULT_PAYMENT_PROVIDER=paystack
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=
# PAYSTACK_WEBHOOK_SECRET=  # optional; defaults to PAYSTACK_SECRET_KEY for HMAC
# PASS_DEFAULT_PRICE_GHS=500
# PASS_PRICE_DELEGATE_GHS=750
# PASS_PRICE_STARTUP_GHS=400
# PASS_PRICE_STUDENT_GHS=150

# ---------------------------------------------------------------------------
# Cloudflare R2 (recommended on production). If unset, uploads use /media/ on the API.
# ---------------------------------------------------------------------------
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET_NAME=ummah-tech-fest-media
# R2_ENDPOINT_URL=https://<account_id>.r2.cloudflarestorage.com
# Optional public CDN/custom domain (no trailing slash):
# R2_PUBLIC_URL=https://media.ummahtechfest.com

# ---------------------------------------------------------------------------
# Production server — use docker-compose.prod.yml (ignore VOLUNTEER_APP_* dev ports)
# ---------------------------------------------------------------------------
# APP_ENV=production
# DEBUG=False
# SEED_ON_START=false
# RUN_COLLECTSTATIC=true
# API_PORT=8000
# FRONTEND_STATIC_PORT=8081
# REDIS_PORT=6380
# SITE_URL=https://ummahtechfest.com
# FRONTEND_URL=https://ummahtechfest.com
# ALLOWED_HOSTS=ummahtechfest.com,www.ummahtechfest.com,127.0.0.1
# CORS_ALLOWED_ORIGINS=https://ummahtechfest.com,https://www.ummahtechfest.com
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_LOGO_URL=https://ummahtechfest.com/assets/images/Ummah-tech-Fest-logo.png
